# SDK-style project build output (per-project bin/obj from the net8.0 port).
# Note: the top-level /bin/ directory holds checked-in legacy vendor tool
# binaries and must NOT be matched by this - these patterns require at
# least one path segment before bin/obj, so top-level /bin/ is unaffected.
*/bin/
*/obj/

# Runtime-generated artifacts - produced fresh by ClassTemplateParser/the
# loc system on every boot, never checked into source control (confirmed:
# zero .Generated.cs files existed anywhere in the repo before these ports).
*.Generated.cs
/Languages/Default/
/steamengine.ini
/steamaux.ini
/steamrc.ini
/Generated/generated-at.txt
/logs/
/scripts/defaults/chardefs/newCharDefsFromMuls.def
/Tests/TestResults/

# Third-party Erebor archive input for SphereShardConverter - not vendored,
# see docs/current/06-tooling/sphere-shard-converter.md for the clone command.
/SphereShardConverter/convert/

# test runs leave real saves here until the next fixture boot cleans them; only the baseline is tracked (#813)
/saves/*
!/saves/2000-01-01/
