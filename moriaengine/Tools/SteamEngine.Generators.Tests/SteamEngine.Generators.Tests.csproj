<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SteamEngineTargetFramework)</TargetFramework>
    <AssemblyName>SteamEngine.Generators.Tests</AssemblyName>
    <RootNamespace>SteamEngine.Generators.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The test platform and Roslyn packages ship resource folders the SDK's locale check rejects; as in Tests.csproj. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamEngine.Generators\SteamEngine.Generators.csproj" />
    <ProjectReference Include="..\SteamEngine.Generators.Abstractions\SteamEngine.Generators.Abstractions.csproj" />
    <ProjectReference Include="..\..\scripts\SteamEngine.Scripts.csproj" />
  </ItemGroup>

</Project>
