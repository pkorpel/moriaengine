<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- #29: WinForms runs only on Windows, but the project still compiles on Linux/macOS, so the solution builds everywhere. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- A Linux/macOS build would make a launcher for its own OS; there the output is the dll only (dotnet SteamEngine.RemoteConsole.dll on Windows). -->
    <UseAppHost Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</UseAppHost>
    <RootNamespace>SteamEngine.RemoteConsole</RootNamespace>
    <AssemblyName>SteamEngine.RemoteConsole</AssemblyName>
    <StartupObject>SteamEngine.RemoteConsole.MainClass</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);MSWIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\SteamEngine.Common.csproj" />
    <ProjectReference Include="..\Communication\SteamEngine.Communication.csproj" />
  </ItemGroup>

</Project>
