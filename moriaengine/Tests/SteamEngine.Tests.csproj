<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SteamEngine.Tests</RootNamespace>
    <AssemblyName>SteamEngine.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Microsoft.TestPlatform.ObjectModel/TestHost ship resource folders
         (zh-hans, pt-br, etc.) that the .NET 8 SDK's locale validator
         doesn't recognize - an upstream packaging issue (still present as
         of Microsoft.NET.Test.Sdk 18.10.1, confirmed by testing), not
         anything in our code. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCore\SteamEngine.GameCore.csproj" />
    <ProjectReference Include="..\ThirdParty\SteamEngine.ThirdParty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.runner.json must sit next to the test assembly at runtime - xUnit reads it
         from there, not from the source tree. diagnosticMessages+longRunningTestSeconds give
         a periodic "still running" heartbeat for any full-boot test exceeding the threshold,
         so a long `dotnet test` run's own console output distinguishes "slow" from "stuck"
         without having to inspect /proc CPU deltas by hand. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
