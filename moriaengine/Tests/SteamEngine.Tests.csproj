<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SteamEngineTargetFramework)</TargetFramework>
    <RootNamespace>SteamEngine.Tests</RootNamespace>
    <AssemblyName>SteamEngine.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Microsoft.TestPlatform.ObjectModel/TestHost ship resource folders
         (zh-hans, pt-br, etc.) that the SDK's locale validator doesn't
         recognize where globalization is invariant (no ICU, as in the dev
         container) - an upstream packaging issue (still present with
         Microsoft.NET.Test.Sdk 18.12.0 on SDK 10), not anything in our code. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCore\SteamEngine.GameCore.csproj" />
    <ProjectReference Include="..\ThirdParty\SteamEngine.ThirdParty.csproj" />
    <ProjectReference Include="..\scripts\SteamEngine.Scripts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.runner.json must sit next to the test assembly at runtime - xUnit reads it
         from there, not from the source tree. diagnosticMessages+longRunningTestSeconds give
         a periodic "still running" heartbeat for any full-boot test exceeding the threshold,
         so a long `dotnet test` run's own console output distinguishes "slow" from "stuck"
         without having to inspect /proc CPU deltas by hand. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
