<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SteamEngine.CompiledScripts</RootNamespace>
    <ScriptsAssemblyNumber>VS</ScriptsAssemblyNumber>
    <AssemblyName>SteamEngine.CompiledScripts.$(ScriptsAssemblyNumber)</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="MySql.Data" Version="8.3.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\SteamEngine.Common.csproj" />
    <ProjectReference Include="..\Communication\SteamEngine.Communication.csproj" />
    <ProjectReference Include="..\GameCore\SteamEngine.GameCore.csproj" />
  </ItemGroup>

</Project>
