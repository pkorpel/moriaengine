<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(SteamEngineTargetFramework)</TargetFramework>
		<RootNamespace>SteamEngine.CompiledScripts</RootNamespace>
		<ScriptsAssemblyNumber>VS</ScriptsAssemblyNumber>
		<AssemblyName>SteamEngine.CompiledScripts.$(ScriptsAssemblyNumber)</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="MySql.Data" Version="9.7.0" />
		<PackageReference Include="System.Management" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common\SteamEngine.Common.csproj" />
		<ProjectReference Include="..\Communication\SteamEngine.Communication.csproj" />
		<ProjectReference Include="..\GameCore\SteamEngine.GameCore.csproj" />
		<ProjectReference Include="..\Tools\SteamEngine.Generators.Abstractions\SteamEngine.Generators.Abstractions.csproj" />
		<ProjectReference Include="..\Tools\SteamEngine.Generators\SteamEngine.Generators.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
