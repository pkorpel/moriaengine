// #734 - test-only content mirroring the real guard (c_vguard_mordor_hala_jezdec) that exposed
// the bug: a melee NPC whose ONLY spells are support/self-targeted (a heal and a buff, no
// offensive spell at all). No CombatSpell, no explicit WeaponType/WeaponRange - BareHands melee,
// same as any other unarmed monster.
[NPCDef npc_test_support_only_caster]
NAME = "Support Only Test Caster"
ANIM = 0x1fff
AddSpell = s_greater_heal
AddSpell = s_magic_reflection
MaxMana = 1000
MaxHits = 1000
CAN = MT_WALK|MT_USEHANDS|MT_RUN
