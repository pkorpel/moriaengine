// #564 - test-only content proving NPCDef.Spells (addspell=) actually gets consulted by
// NPCAiTimer.PickSpell, picking uniformly at random among the granted list, and that the
// single-CombatSpell-only path (no AddSpell at all) still works unchanged.
[NPCDef npc_test_multi_spell]
NAME = "Multi Spell Test"
ANIM = 0x1fff
AddSpell = s_magic_arrow
AddSpell = s_fireball

[NPCDef npc_test_single_combat_spell]
NAME = "Single Combat Spell Test"
ANIM = 0x1fff
CombatSpell = s_magic_arrow
