// #606 - "Converter: map real tag.resist_X damage-resist tags onto NPCDef's existing
// ResistX fields" - test-only content proving the real engine ResistX fields (already
// live, consumed in DamageManager.GetResistModifier) actually apply when set via a
// .def file the same way the converter now emits them. ResistSlashing/ResistStabbing
// both set here to cover the "sharp" dual-write case (DamageType.Sharp = Slashing|Stabbing,
// no dedicated ResistSharp property exists).
[NPCDef npc_test_resist]
NAME = "Resist Test"
ANIM = 0x1fff
ResistPoison = 850
ResistFire = 200
ResistElectric = 100
ResistSlashing = -100
ResistStabbing = -100
