class_info_class_necro_tag[9] ""
class_info_class_necro_max_points[9] none
class_info_class_necro_function[9] none
class_info_class_necro_description[9] "Nekromant je schopen monstrum proklit - jedna se o velmi silne kouzlo, ktere nekromantovi umozni snizit odolnost monstra vuci ohni a tak jej muze nekromant lepe zranit."

