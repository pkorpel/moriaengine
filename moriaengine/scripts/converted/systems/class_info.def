class_info_class_war_name[0] Dvojity zasah
class_info_class_war_tag[0] ra_Doubleswing
class_info_class_war_max_points[0] 40
class_info_class_war_function[0] none
class_info_class_war_description[0] "Tato automaticka schopnost umoznuje valecnikovi zasahnout monstrum o 50% silneji. K teto schopnosti je treba uzivat spravne zbrane (Long sword, Broad sword, LBA, Double axe a 2hand axe) a mit dostatek staminy. Tuto schopnost je mozno 4x po deseti bodech vylepsit a zvednout tak sanci na zasazeni dvojiteho zasahu. Dvojity zasah se lze naucit od 30. urovne valecnika."

class_info_class_war_name[1] Roundattack
class_info_class_war_tag[1] ra_roundattack
class_info_class_war_max_points[1] 40
class_info_class_war_function[1] roundattack
class_info_class_war_description[1] "Tato schopnost umoznuje zasahnout vsechna monstra v tesne blizkosti valecnika. K teto schopnosti je treba uzivat obourucni zbran a mit dostatek staminy."

class_info_class_war_name[2] Omracujici uder
class_info_class_war_tag[2] ra_stuntattack
class_info_class_war_max_points[2] 10
class_info_class_war_function[2] omraceni
class_info_class_war_description[2] "Tato schopnost valecnika umoznuje zasahnout monstrum tak, aby bylo omraceno na dobu dvou vterin. K teto schopnosti je treba uzivat drtive zbrane (kladiva) a mit dostatek staminy. Tuto schopnost je mozno dale vylepsovat.."

class_info_class_war_name[3] Omracujici uder - ucinnost
class_info_class_war_tag[3] ra_stuntattack_ucinnost
class_info_class_war_max_points[3] 30
class_info_class_war_function[3] omraceni
class_info_class_war_description[3] "Schopnost omracit monstrum je zavisla na materialu zbrane a na obtiznosti monstra. Lze vsak 3x po deseti bodech vylepsit ucinnost omraceni a  dokjazat tak omracit jeste silnejsi monstra nez drive."

class_info_class_war_name[4] Omracujici uder - prodleva
class_info_class_war_tag[4] ra_stuntattack_prodleva
class_info_class_war_max_points[4] 30
class_info_class_war_function[4] omraceni
class_info_class_war_description[4] "Omracujici uder je mozno 3x po deseti bodech vylepsit a zkratit tak dobu, kdy je mozno pouzit uder znovu."

class_info_class_war_name[5] Leap
class_info_class_war_tag[5] ra_leap
class_info_class_war_max_points[5] 10
class_info_class_war_function[5] leap
class_info_class_war_description[5] "Tato schopnost valecnika umoznuje dostihnout jineho hrace tim, ze valecnik k nemu rychle priskoci. Vzdalenost tohoto doskoku je mozno prodlouzit za pomoci schopnosti longrange."

class_info_class_war_name[6] Longrange
class_info_class_war_tag[6] ra_rangearrow
class_info_class_war_max_points[6] 10
class_info_class_war_function[6] longrange
class_info_class_war_description[6] "Tato schopnost umoznuje valecnikovi prodlouzit dosah jeho leapu a priskocit k nepriteli, ktery by jinak byl mimo dosah. Dale ma vliv na vzdalenost hazenych bomb."

class_info_class_war_name[7] Valecny krik
class_info_class_war_tag[7] ra_warcry
class_info_class_war_max_points[7] 10
class_info_class_war_function[7] warcry
class_info_class_war_description[7] "Jde o bojovy krik valecnika, ktery jim narusi koncentraci vsech nepratel v okoli a prerusi jejich kouzleni. Schopnost je mozno pouzit jedenkrat za minutu a funguje jak na hrace tak monstra."

class_info_class_war_name[8] Hazeni
class_info_class_war_tag[8] ra_throwing
class_info_class_war_max_points[8] 10
class_info_class_war_function[8] throwexplosion
class_info_class_war_description[8] "Tato schopnost umoznuje valecnikovi hazet bomby (prikaz .throwexplosion). Prodlouzeni dosahu hodu je mozne za pomoci ability Longrange. Dale je tuto schopnost mozno vyuzit i na hazeni dispelujici bomby - prikaz .throwdispel."

class_info_class_war_name[9] Obranny postoj
class_info_class_war_tag[9] ra_defstance
class_info_class_war_max_points[9] 10
class_info_class_war_function[9] stance
class_info_class_war_description[9] "Tato schopnost umoznuje valecnikovi se vice soustredit na obranu a snizit tak obdrzene zraneni o 25%. Toto soustredeni vsak vyrazne snizuje zraneni, ktere valecnik zpusobuje. Ke zmene postaveni je treba mit minimalne 80 bodu staminy."

