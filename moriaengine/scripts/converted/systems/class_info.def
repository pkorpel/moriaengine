class_info_class_shaman_name[0] Negativni Voodoo - Kletba
class_info_class_shaman_tag[0] ra_woodoo_curse
class_info_class_shaman_max_points[0] 40
class_info_class_shaman_function[0] none
class_info_class_shaman_description[0] "Kletba je soucasti skoly negativniho voodoo - umoznuje proklit nepritele a zpusobit mu tak velke nesnaze. Je k tomu treba jeho hlavu a dyku - efekt je dle pouziteho materialu dyky. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[1] Negativni Voodoo - Oslabeni
class_info_class_shaman_tag[1] ra_woodoo_curse
class_info_class_shaman_max_points[1] 40
class_info_class_shaman_function[1] oslabenivoodoo
class_info_class_shaman_description[1] "Oslabeni je soucasti skoly negativniho voodoo - umoznuje oslabit odolnost monstra vuci zraneni chladem. Toto oslabeni se projevuje nejen na zraneni zpusobenem samanem, ale i ostatnimi postavami. Nelze ovsem oslabit monstrum zcela imunni na ledova kouzla. K provedeni teto schopnosti je treba drahokam - Rubin. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[2] Negativni Voodoo - Koncentrace
class_info_class_shaman_tag[2] ra_woodoo_curse
class_info_class_shaman_max_points[2] 40
class_info_class_shaman_function[2] none
class_info_class_shaman_description[2] "Koncentrace je soucasti skoly negativniho voodoo - umoznuje samanovi zasadit monstru zdrcujici uder kouzlem - tento uder je pak o 40% silnejsir. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[3] Pozitivni voodoo - Boost
class_info_class_shaman_tag[3] ra_woodoo
class_info_class_shaman_max_points[3] 30
class_info_class_shaman_function[3] none
class_info_class_shaman_description[3] "Boost je soucasti skoly pozitivniho voodoo - umoznuje samanovi posilovat (boostovat) sve spolubojovniky i sebe. Saman krome lehkeho lektvaru, ktery urcuje efekt, potrebuje i hlavu toho, koho chce posilit. Tuto schopnost je mozno 2x po deseti bodech vylepsit."

class_info_class_shaman_name[4] Pozitivni voodoo - Vitalita
class_info_class_shaman_tag[4] ra_woodoo
class_info_class_shaman_max_points[4] 10
class_info_class_shaman_function[4] voodoovit
class_info_class_shaman_description[4] "Vitalita je soucasti skoly pozitivniho voodoo - umoznuje samanovi docasne presunout 30 bodu z inteligence do vitality. K provedeni teto schopnosti je treba drahokam - Rubin. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[5] Pozitivni voodoo - Inteligence
class_info_class_shaman_tag[5] ra_woodoo
class_info_class_shaman_max_points[5] 10
class_info_class_shaman_function[5] voodooint
class_info_class_shaman_description[5] "Inteligence je soucasti skoly pozitivniho voodoo - umoznuje samanovi docasne presunout 30 bodu z vitality do inteligence. K provedeni teto schopnosti je treba drahokam - Rubin. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[6] Pozitivni voodoo - Rovnovaha
class_info_class_shaman_tag[6] ra_woodoo
class_info_class_shaman_max_points[6] 10
class_info_class_shaman_function[6] voodoorovnovaha
class_info_class_shaman_description[6] "Rovnovaha je soucasti skoly pozitivniho voodoo - umoznuje samanovi vratit sve staty do normalu. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[7] Pozitivni voodoo - Obet
class_info_class_shaman_tag[7] ra_woodoo_obet
class_info_class_shaman_max_points[7] 30
class_info_class_shaman_function[7] voodooobet
class_info_class_shaman_description[7] "Voodoo obet je soucasti skoly pozitivniho voodoo - umoznuje samanovi presunout cast sve zivotni energie do magicke energie. Tuto schopnost je mozno 3x po deseti bodech vylepsit."

class_info_class_shaman_name[8] Voodoo pakty - pakt krve
class_info_class_shaman_tag[8] ra_woodoo_pacts_boost
class_info_class_shaman_max_points[8] 20
class_info_class_shaman_function[8] bloodpact
class_info_class_shaman_description[8] "Pakt krve je soucasti skoly voodoo pakty - umoznuje samanovi presunout cast zraneni svych spolubojovniku na sebe. Saman automaticky obdrzi zkusenosti, pokud je ziska spolubojovnik, s nimz je spojen. Tuto schopnost je mozno 2x po deseti bodech vylepsit."

class_info_class_shaman_name[9] Voodoo pakty - pakt zivota
class_info_class_shaman_tag[9] ra_woodoo_lifepact
class_info_class_shaman_max_points[9] 30
class_info_class_shaman_function[9] lifepact
class_info_class_shaman_description[9] "Pakt zivota je soucasti skoly voodoo pakty - umoznuje samanovi ulozit svoji (nebo spolubojovnikovu) dusi do schranky a za jeji pomoci se potom ozivit. Tuto schopnost je mozno 3x po deseti bodech vylepsit."

class_info_class_shaman_name[10] Voodoo pakty - pakt many
class_info_class_shaman_tag[10] ra_pakty
class_info_class_shaman_max_points[10] 10
class_info_class_shaman_function[10] manapact
class_info_class_shaman_description[10] "Pakt many je soucasti skoly voodoo pakty - umoznuje samanovi sobe nebo svym spolubojovnikum vyrazne zvysit regeneraci many. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[11] Voodoo pakty - pakt staminy
class_info_class_shaman_tag[11] ra_pakty
class_info_class_shaman_max_points[11] 10
class_info_class_shaman_function[11] staminapact
class_info_class_shaman_description[11] "Pakt staminy je soucasti skoly voodoo pakty - umoznuje samanovi sobe nebo svym spolubojovnikum vyrazne zvysit regeneraci staminy. Tato schopnost zadne specialni body nevyzaduje."

class_info_class_shaman_name[12] Standcast
class_info_class_shaman_tag[12] none
class_info_class_shaman_max_points[12] none
class_info_class_shaman_function[12] standcast
class_info_class_shaman_description[12] "Tato schopnost vyrazne zvysi zraneni kouzly do monster (konkretne o jedno procento navic za kazdy level). Cenou za navyseni zraneni je nemoznost pohybu behem kouzleni. Stejnym prikazem se zapina a vypina."

