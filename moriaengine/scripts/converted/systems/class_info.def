class_info_class_ranger_tag[6] ra_splitshot
class_info_class_ranger_max_points[6] 20
class_info_class_ranger_function[6] splitshot
class_info_class_ranger_description[6] "Tato schopnost umoznuje zasahnout jednim rozdelenym sipem vice nepratel v okoli primarniho cile utoku a lze ji pouzit se vsemi strelnymi zbranemi. Rozdelena strela funguje jak v PvM tak v PvP."

class_info_class_ranger_name[7] Drtivy sip
class_info_class_ranger_tag[7] ra_crushingArrow
class_info_class_ranger_max_points[7] 20
class_info_class_ranger_function[7] crushingArrow
class_info_class_ranger_description[7] "Tato schopnost umoznuje zasahnout cil drtivym sipem, ktery sice cili neudeli zraneni, ale na kratkou dobu mu snizi fyzickou odolnost. Tedy vsichni utocnici se secnymi, ostrymi, tupymi a strelnymi zbranemi z tohoto efektu budou profitovat zvysenym zranenim. Cil pod vlivem teto ability je oznacen animaci terce. Pocet bodu v teto abilite ovlivnuji delku trvani a velikost snizeni fyzicke odolnosti cile. Tato abilita je dostupna od 30. levelu."

class_info_class_ranger_name[8] Znalost jezditek
class_info_class_ranger_tag[8] ra_mountsKnowledge
class_info_class_ranger_max_points[8] 20
class_info_class_ranger_function[8] boosty
class_info_class_ranger_description[8] "Znalost jezditek rangera ovlivnuje vysi bonusu ziskane z jezditka na kterem prave sedi. K ziskani bonusu je potreba mit skilly Animal Taming a Animal Lore. Dale je treba mit body v teto schopnosi a ziskat samotnou znalost jednotlivych jezditek. Tuto znalost ziska ranger tamovanim jednotlivych typu jezditek na jejich spawnech. Informace o stavu znalosti lze dohledat v menu .boosty. Touto schopnosi lze ziskat az o 100% vetsi bonus z jezditka, nez bez nej. Tuto schopnost se muze ucit ranger jiz po dovrseni 12. urovne."

class_info_class_ranger_name[9] Krvelacnost
class_info_class_ranger_tag[9] ra_killingSpree
class_info_class_ranger_max_points[9] 20
class_info_class_ranger_function[9] none
class_info_class_ranger_description[9] "Tato schopnost se sama aktivuje ve chvili, kdy ranger svym vystrelem dorazi svuj cil. Timto ziska bod krvelacnosti, kterych lze ziskat maximalne 3 a to opetovnym zabitim cilu v rade. Kazdy bod krvelacnosti zvysuje rangerovi sanci na kriticky zasah a navysuje poskozeni nasledujiciho vystelu. Tuto schopnost lze se ucit od 50. urovne."

//////////////////////////////////////////////////////////////////
////////////////////////////// MYSTIK ////////////////////////////
//////////////////////////////////////////////////////////////////

// class mystik
class_info_class_mystik_abilities 9 // number of abilities == kazda pridana abilita +1

class_info_class_mystik_name[0] Astral power
class_info_class_mystik_tag[0] none
class_info_class_mystik_max_points[0] none
class_info_class_mystik_function[0] astralpower
class_info_class_mystik_description[0] "Specialni schopnost umoznujici zasadit omracujici uder pri utoku. Sance uspesnosti na hrace je snizena o 66%. Sance na uspesnost se zvysuje s levelem."

class_info_class_mystik_name[1] Zmena druhu uderu
class_info_class_mystik_tag[1] none
class_info_class_mystik_max_points[1] none
class_info_class_mystik_function[1] switchmagic
class_info_class_mystik_description[1] "Schopnost menit svuj zakladni uder mezi dvema moznymi magickymi skolami chladu a energie. Tato schopnost dava mystikovi moznost reagovat na resisty monster."

class_info_class_mystik_name[2] Longrange
class_info_class_mystik_tag[2] ra_rangearrow
class_info_class_mystik_max_points[2] 10
class_info_class_mystik_function[2] longrange
class_info_class_mystik_description[2] "Tato schopnost umoznuje prodlouzit vzdalenost, na kterou je schopen hodit bombu ci dispelbombu."

class_info_class_mystik_name[3] Hazeni
class_info_class_mystik_tag[3] ra_throwing
class_info_class_mystik_max_points[3] 10
class_info_class_mystik_function[3] throw
class_info_class_mystik_description[3] "Tato schopnost umoznuje hazet bomby (prikaz .throwexplosion). Prodlouzeni dosahu hodu je mozne za pomoci ability Longrange. Dale je tuto schopnost mozno vyuzit i na hazeni dispelujici bomby - prikaz .throwdispel."

class_info_class_mystik_name[4] Ovladani NPC
class_info_class_mystik_tag[4] ra_controlnpc
class_info_class_mystik_max_points[4] 20
class_info_class_mystik_function[4] controlnpc
class_info_class_mystik_description[4] "Schopnost ovladnout summona nebo ochocenou jezdeckou zver. Vzhledem k jezdecke zveri je potreba mit i skill Animal Lore. K teto schopnosti je potreba mit kristalovou kouli."

class_info_class_mystik_name[5] Uchopeni mysli
class_info_class_mystik_tag[5] ra_catch
class_info_class_mystik_max_points[5] 20
class_info_class_mystik_function[5] catch
class_info_class_mystik_description[5] "Schopnost docasne znehybnit cil silou sve mysli. Pouziti uchopeni mysli vyzaduje hypnokouli."

class_info_class_mystik_name[6] Ovladnuti talentu
class_info_class_mystik_tag[6] ra_buffSteal
class_info_class_mystik_max_points[6] 20
class_info_class_mystik_function[6] buffsteal
class_info_class_mystik_description[6] "Schopnost ukrast monstru urcity talent. Tento talent ma k ovladnuti kazda potvora jiny. Na abilitu je potreba urcity pocet many, staminy a vlastnit krystalovou kouli."

class_info_class_mystik_name[7] Zdrcujici uder
class_info_class_mystik_tag[7] ra_mystikDoubleswing
class_info_class_mystik_max_points[7] 40
class_info_class_mystik_function[7] none
class_info_class_mystik_description[7] "Pasivni schopnost pri jakemkoli utoku do monstra udelit zdrujici uder, ktery zvysi silu utoku."

class_info_class_mystik_name[8] Hypnoza
class_info_class_mystik_tag[8] none
class_info_class_mystik_max_points[8] none
class_info_class_mystik_function[8] hypnotize
class_info_class_mystik_description[8] "Schopnost ovladnuti tela nekterych NPC, tak ze svou dusi premisti do tela obludy. K uspesne hypnoze je potreba aktivovana hypnotizerska koule a magicka hul z dubu (oak) nebo lepsiho materialu. Deaktivuje se rovnez tak, smrti NPC, nebo sama casem, ktery zavisi na levelu postavy a narocnosti cile. Moznost pouziti neni omezena levelem postavy ani investovanymi body."

