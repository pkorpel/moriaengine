// Serves as the booster TAG storage - i.e. carries all the unused boosters
// a player acquired in the game.

[EquippableDef i_playerBoosters]
name = "Player Boosters"
TYPE = t_eq_script
model = i_memory
Layer = layer_special //guessed from base def by Converter 

[EquippableDef i_booster]
name = "Player Boost"
TYPE = t_eq_script
model = i_skull_candle_lit
layer = 2 //Set by Converter 

