//Zamerovatko pro zacileni pro odeslani zpravy
[ScriptedTargetDef targ_delayed_message] //argv(1) muze byt rovnou text zpravy anebo null!
message="Komu chces poslat delayed message?"

on=@start
sysmessage(targ_delayed_message.message)
return 0

on=@targon_char //zamereno  argv(0)
if(argv(1) != null) //mame text zpravy
	if(!argv(0).IsPlayer)
		sysmessage("Zameruj hrace")
		Target(targ_delayed_message,<argv(1)>)
		return 1
	endif
	argv(0).delayedmessage(this,argv(1))
	sysmessage("Hraci <argv(0).name> odeslana zprava <argv(1)>")
else
	if(!argv(0).IsPlayer)
		sysmessage("Zameruj hrace")
		Target(targ_delayed_message)
		return 1
	endif
	Dialog(input_delayed_message,argv(0))
endif

on=@targon_ground
sysmessage("Zameruj hrace")
Target(targ_delayed_message)
return 1

on=@targon_item
sysmessage("Zameruj hrace")
Target(targ_delayed_message)
return 1

//dialog na vepsani zpravy (pokud je potreba)
[InputDef input_delayed_message] //argv1 - cil zpravy
label="Napis zpravu"
default=""

on=@response
argv(1).delayedmessage(this,argv(0))
sysmessage("Hraci <argv(1).name> odeslana zprava <argv(0)>")

[function sendMessage]//v argu lze rovnou specifikovat zpravu
if(argvcount == 0)
	Target(targ_delayed_message)
else
	Target(targ_delayed_message,<argv(0)>)
endif