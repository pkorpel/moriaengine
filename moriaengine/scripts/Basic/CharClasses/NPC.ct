[ThingTemplate NPC : Character]
Defs:
	double weaponAttack = 1	
	double weaponPiercing = 0
	double weaponDelay = 2.0
	WeaponType weaponType = WeaponType.Undefined
	DamageType naturalDamageType = DamageType.Irresistable
	int weaponRange = 1
	int strikeStartRange = 5
	int strikeStopRange = 10
	int projectileAnim = -1
	double mindPower = 1
	int bloodColor = -1
	int mountColor = -1
	//#1375 - these were tags behind hand-written properties until then
	//AggroMode: Calm (fights back), Hostile (wild monsters), GuardsRealm (town guards)
	AggroMode aggroMode = AggroMode.Calm
	//#700 - the realm a GuardsRealm NPC protects, seeded onto each new one (Erebor's tag.guard)
	Realm realm = Realm.None
	//#828 - the one skill an Erebor skill teacher (spk_mistr, tag.ucimskill) teaches, None for everyone else
	SkillName teachesSkill = SkillName.None
	//#590 - Erebor's MOVERATE, 3 is the baseline of one tile per AI tick, higher is faster
	double moveRate = 3.0
	//#716 - how far it keeps while casting, negative means the AI's own default
	double spellCastRange = -1
	//#794 - Erebor's tag(isBoss,1): never becomes an elite monster
	bool isBoss = false
	//#1017 - Erebor's NPC=brain_dragon: a dragonslayer counts in full when no monstertype says dragon
	bool dragonBrain = false
	//#962 - Erebor's tag(noanimate,1): its corpse can't be raised
	bool noAnimate = false
	//#1017 - Erebor's tag.hypnotizable, flags_hypno: can be hypnotized, may loot, the talents a mystic can steal
	int hypnotizable = 0
	//#1070 - Erebor's tag.resist_silence, permille against Mind Blast's silence, 1000 or more can't be silenced
	int resistSilence = 0
	//#1017 - Erebor's tag.monstertype, monstertype2, monstertype3: kind[,percent] for slayers
	string monsterType = null
	string monsterType2 = null
	string monsterType3 = null
	//#925 - Erebor's tag(magic_horse,name): the mount's powers, MountPowers' table of that name
	string magicHorse = null
	//#1022 - Erebor's tag.had: the serpent druid's serpent form, a chardef whose look it takes
	string serpentForm = null
	//enhancements #57 - the spell it casts at its target instead of swinging, null for weapons only
	SpellDef combatSpell = null
	//#700 - the mount species it spawns riding (Erebor's tag.mount), keyword mountnpc; null for none
	NPCDef mountCharDef = null
	//#1405 - the add-up lists, one element per script line (NPCDef.LoadScriptLine gathers them), read as Spells, Loot...
	//Not named as their keywords: a line named as a field loads at once, before the other scripts (AbstractDef.LoadScriptLines)
	SpellDef[] spellList = null
	NPCDef[] summonList = null
	NPCDef[] battleSummonList = null
	String[] lootList = null
	//Equip lines, and each one's EquipColor and EquipName ("" where none), by index
	String[] equipList = null
	String[] equipColorList = null
	String[] equipNameList = null
	//"amount defname" each, the last Resources line; "[amount] category" each, the last FoodType line
	String[] resourceList = null
	String[] foodTypeList = null
	//"SkillName min max" and "ResistX min max" each
	String[] skillRangeList = null
	String[] resistRangeList = null
	//Sphere's CAN text, e.g. MT_WALK|MT_SWIM
	string can = null
	//#1377 - {min,max} ranges, rolled per NPC or per use; a script line gives "min max" or one value for both
	Int32[] experienceWorth = null
	Int32[] strRange = null
	Int32[] dexRange = null
	Int32[] intRange = null
	Int32[] stunChance = null
	Int32[] stunDuration = null
	Int32[] stunCooldown = null
	Int32[] criticChance = null
	Int32[] criticDamage = null
	Int32[] roundattackChance = null
	Int32[] roundattackDamage = null
	Int32[] roundattackCooldown = null
	Int32[] pullDistance = null
	Int32[] bleedChance = null
	Int32[] knockbackChance = null
	Int32[] npcSpeed = null
	Int32[] selfresDelay = null
	Int32[] paraKrikChance = null
	Int32[] paraKrikCooldown = null
	Int32[] npcCurseChance = null
	Int32[] npcCurseCooldown = null
	Int32[] npcCurseDamage = null
	Int32[] sniperChance = null
	Int32[] sniperDamage = null
	Int32[] summoningChance = null
	Int32[] summoningCooldown = null
	Int32[] summoningLifetime = null
	Int32[] phoenixFireDamage = null
	Int32[] explodeDamage = null
	Int32[] regenerationHp = null
	Int32[] regenerationInterval = null
	Int32[] lifeLeechAmount = null
	Int32[] reactiveArmorPercent = null
	Int32[] stamDmgChance = null
	Int32[] stamDmgPower = null
	Int32[] lifeLeechCap = null
	Int32[] acidChance = null
	Int32[] acidDamage = null
	Int32[] deathDamage = null
	Int32[] regenerationDivisor = null
	Int32[] resistCountdownChance = null
	Int32[] resistCountdownAmount = null
	Int32[] lightningsChance = null
	Int32[] lightningsRange = null
	Int32[] npcCurseManaChance = null
	Int32[] npcCurseManaCooldown = null
	Int32[] npcCurseManaDamage = null
	Int32[] npcCurseStamChance = null
	Int32[] npcCurseStamCooldown = null
	Int32[] npcCurseStamDamage = null
	Int32[] pushallChance = null
	Int32[] pushallCooldown = null
	Int32[] magicShieldStrength = null
	Int32[] dupeCount = null
	Int32[] backstabDamageReducer = null
	Int32[] multishotChance = null
	Int32[] multishotCooldown = null
	Int32[] multishotDamage = null
	Int32[] dispelBombChance = null
	Int32[] dispelBombRange = null
	Int32[] dispelBombCooldown = null
	Int32[] warcryCooldown = null
	Int32[] fameRange = null
	Int32[] karmaRange = null
	Int32[] maxHitsRange = null
	Int32[] maxStamRange = null
	Int32[] maxManaRange = null
	Int32[] fireDragonChance = null
	Int32[] fireDragonCooldown = null
	Int32[] fireDragonDamage = null
	Int32[] fireDragonFireType = null
	Int32[] fireDragonBombChance = null
	Int32[] fireDragonBombCooldown = null
	Int32[] fireDragonBombDamage = null
	Int32[] fireDragonBombFireType = null
	Int32[] fireDragonRoundChance = null
	Int32[] fireDragonRoundCooldown = null
	Int32[] fireDragonRoundDamage = null
	Int32[] fireDragonRoundFireType = null
	Int32[] fireDragonRoundTurns = null
	Int32[] fireDragonCageChance = null
	Int32[] fireDragonCageCooldown = null
	Int32[] fireDragonCageFireType = null
	Int32[] fireDragonCageDuration = null
	Int32[] fireDragonAuraChance = null
	Int32[] fireDragonAuraCooldown = null
	Int32[] fireDragonAuraInterval = null
	Int32[] fireDragonAuraTicks = null
	Int32[] fireDragonAuraDamage = null
	Int32[] fireDragonAuraResist = null
	Int32[] swampDragonAuraChance = null
	Int32[] swampDragonAuraCooldown = null
	Int32[] swampDragonAuraInterval = null
	Int32[] swampDragonAuraTicks = null
	Int32[] swampDragonAuraDamage = null
	Int32[] lavaBombChance = null
	Int32[] lavaBombRange = null
	Int32[] lavaBombCooldown = null
	Int32[] bombaBoyDamage = null
	Int32[] rozdeleniCopyChance = null
	Int32[] frostWaveChance = null
	Int32[] frostWaveStrength = null
	Int32[] warniakType = null
	Int32[] warniakCount = null
	Int32[] warniakDropHitChance = null
	Int32[] npcPortDistance = null
	Int32[] hcnMadnessChance = null
	Int32[] hcnMadnessStrength = null

Vars:	//vars defined in the class, so they basically do what tags do, but better
	private IMovementSettings movementSettings = null 

	short maxStamina=100
	short maxHitpoints=100
	short maxMana=100



