[PluginTemplate MysticProfessionPlugin : ProfessionPlugin]
Vars:
	internal double nextCatchField = 0

[PluginTemplate CatchPlugin : TimerPlugin]
Vars:
	internal Character monster = null
	internal int ticks = 0
	internal int monsterExp = 0

[PluginTemplate CatchFieldPlugin : TimerPlugin]
Vars:
	internal int effort = 0
	internal List<NPC> held = null

[PluginTemplate CaughtPlugin : Plugin]
Vars:
	internal Character mystic = null
	internal int power = 0

[PluginTemplate ControlNpcPlugin : TimerPlugin]
Vars:
	internal Character target = null

[PluginTemplate BuffStealPlugin : TimerPlugin]
Vars:
	internal Character target = null
	internal int type = 0
	internal int power = 0
	internal int changed = 0
	internal int state = 0
	internal bool success = false
	internal int bonus = 0

[PluginTemplate BuffStolenPlugin : TimerPlugin]
Vars:
	internal int type = 0
	internal int changed = 0
	internal int cut = 0
