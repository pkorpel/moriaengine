[PluginTemplate ShamanProfessionPlugin : ProfessionPlugin]
Vars:
	internal double nextVoodoo = 0
	internal double nextPact = 0
	internal double nextLifePact = 0

[PluginTemplate VoodooStatsPlugin : Plugin]
Vars:
