//#962 - Erebor's necromancy, systems/NecroBook.scp and [SPELL 65-70] of spheretable_x.scp. Live numbers come from
//systems/spellvalues.def. The book holds these past its 64 spells, see SpellBook.necroSpells.

[DurableCharEffectSpellDef 68]
DEFNAME = s_light
NAME = Light
SOUND = 483
RUNES = IL
CASTTIME = 4.0
SCROLLITEM = i_scroll_light
FLAGS = SpellFlag.CanTargetChar | SpellFlag.CanEffectChar | SpellFlag.EffectNeedsLOS | SpellFlag.IsBeneficial
EFFECT = LightAndWeather.UndergroundLight
DURATION = 180,300
MANAUSE = 8
Requirements = 30.0 Magery
EffectPluginDef = p_nightsight
EffectPluginKey_Spell = @@spellEffect_light
EffectPluginKey_Potion = @@potionEffect_light

on=@effectChar
	EffectFactory.StationaryEffect(this, 0x376A, 9, 32)

[DamageSpellDef 69]
DEFNAME = s_fire_bolt
NAME = Fire Bolt
SOUND = 351
RUNES = VFP
CASTTIME = 2.5
SCROLLITEM = i_scroll_firebolt
FLAGS = SpellFlag.CanTargetChar | SpellFlag.CanEffectChar | SpellFlag.EffectNeedsLOS | SpellFlag.UseMindPower | SpellFlag.IsHarmful
DamageType = DamageType.MagicFire
EFFECT = 0,17
ArmorPiercing = 850
MANAUSE = 22
Requirements = 60.0 Magery
difficulty = 600

on=@effectChar
	EffectFactory.EffectFromTo(argo.Caster, this, 0x36D4, 7, 0, false, true)

[FrostBoltSpellDef 70]
DEFNAME = s_frost_bolt
NAME = Frost Bolt
SOUND = 0x456
RUNES = TUH
CASTTIME = 2.0
SCROLLITEM = i_scroll_frostbolt
FLAGS = SpellFlag.CanTargetChar | SpellFlag.CanEffectChar | SpellFlag.EffectNeedsLOS | SpellFlag.UseMindPower | SpellFlag.IsHarmful
DamageType = DamageType.MagicCold
EFFECT = 0,30
ArmorPiercing = 0
MANAUSE = 20
Requirements = 70.0 Magery
difficulty = 700

on=@effectChar
	EffectFactory.StationaryEffect(this, 0x3818, 12, 1)

[SummonSpellDef 65]
DEFNAME = s_summon_undead
NAME = Summon Undead
SOUND = 586
RUNES = KNM
CASTTIME = 2.0
RESOURCES = i_reag_blood_moss, i_reag_bone, i_reag_blood_vial
SCROLLITEM = i_scroll_summon_undead
FLAGS = SpellFlag.CanTargetAnything | SpellFlag.CanEffectGround | SpellFlag.EffectNeedsLOS
EFFECT = 0
DURATION = 120,180
MANAUSE = 15
Requirements = 40.0 Magery
//Sphere's roll of 15: a lich once, skeletons 4 times, zombies the rest
summonChars = c_liche_necro, c_skeleton_necro, c_skeleton_necro, c_skeleton_necro, c_skeleton_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro, c_zombie_necro

[AnimateDeadSpellDef 66]
DEFNAME = s_animate_dead
NAME = Animate Dead
SOUND = 488
RUNES = IAMG
CASTTIME = 8.0
SCROLLITEM = i_scroll_animate_dead
FLAGS = SpellFlag.CanTargetChar | SpellFlag.CanTargetItem | SpellFlag.CanEffectChar | SpellFlag.CanEffectItem | SpellFlag.EffectNeedsLOS
EFFECT = 0
MANAUSE = 100
Requirements = 70.0 Magery

//cast only through .necroarmor and its scroll, see BoneArmor.cs; here for the book's bit and the scroll
[SpellDef 67]
DEFNAME = s_bone_armor
NAME = Bone Armor
SOUND = 577
RUNES = ICSY
CASTTIME = 4.0
SCROLLITEM = i_scroll_bone_armor
FLAGS = SpellFlag.AlwaysTargetSelf
EFFECT = 0
MANAUSE = 10
Requirements = 30.0 Magery
