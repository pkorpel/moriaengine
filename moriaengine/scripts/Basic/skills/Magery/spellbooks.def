[SpellBookDef 0xefa]
CATEGORY = Provisions - Alchemy & Magic
SUBSECTION = Magical Items
DESCRIPTION = Spellbook

TYPE = T_SPELLBOOK
WEIGHT = 1
//RESOURCES = 80 I_PARCHMENT, 1 I_HIDE, 1 I_CLOTH // commented out by Converter 
LAYER = 1 // this is wrong in TILEDATA ? 
DEFNAME = i_spellbook

[SpellBookDef i_spellbook_1]
name = "spellbook 1"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - ported from itemb3.def's now-dead stub (same defname, lost the class-change
//collision) - this color was silently missing from the real entry.
Color = 038

on=@create
this.Contents = 0xff

[SpellBookDef i_spellbook_2]
name = "spellbook 2"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - same port as i_spellbook_1 above.
Color = 096

on=@create
this.Contents = 0xffff

