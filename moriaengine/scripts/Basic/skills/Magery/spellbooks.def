name = "spellbook 5"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - same port as i_spellbook_1 above.
Color = 028

on=@create
this.Contents = 0xffffffffff

[SpellBookDef i_spellbook_6]
name = "spellbook 6"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - same port as i_spellbook_1 above.
Color = 026

on=@create
this.Contents = 0xffffffffffff

[SpellBookDef i_spellbook_7]
name = "spellbook 7"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - same port as i_spellbook_1 above.
Color = 020

on=@create
this.Contents = 0xffffffffffffff

[SpellBookDef i_spellbook_8]
name = "spellbook 8"
model = i_spellbook
layer = 1 //Set by Converter
//#628 - same port as i_spellbook_1 above.
Color = 0481

on=@create
this.Contents = 0xff

//#962 - Erebor's book is a plain one by more1=0ffffff in tm_necronewbie, its necromancy lies past the 64 spells,
//see SpellBook.necroSpells. A 0x2253 book doesn't exist in 3.0.6m.
//#1001 - the archive has no definition for it, the contents are the user's call: circles 1-3 and all six, as
//i_spellbook_pvp's morex=0ff. d_nec also asks for Summon Creature before it shows Summon Undead, so that comes too.
[SpellBookDef i_spellbook_necro]
name = "Book of necromancy"
model = i_spellbook
layer = 1 //Set by Converter
//#625 - ported from systems/NecroBook.def's now-dead stub (same defname, lost the
//class-change collision) - this color was silently missing from the real entry.
Color = 038d

on=@create
this.Contents = 0xffffff
this.AddSpell(40)
this.necroSpells = 0x3f

//#1116 - Erebor's i_spellbook_pvp (sphereitemb3.scp), the PvP event kit's book (PvpEventKit): 23 magery spells, and
//morem=1 + morex=0ff, so that a necromancer opening it gets the necro book with every necro spell (f_necrobook).
//Erebor's value=300 has nothing to read it here.
[SpellBookDef i_spellbook_pvp]
name = "PVPEVENT"
model = i_spellbook
layer = 1
Color = 038d

on=@create
this.AddSpell(12) //harm
this.AddSpell(18) //fireball
this.AddSpell(41) //dispel
this.AddSpell(42) //energy bolt
this.AddSpell(36) //magic reflection
this.AddSpell(37) //mind blast
this.AddSpell(6) //night sight
this.AddSpell(20) //poison
this.AddSpell(11) //cure
this.AddSpell(4) //heal
this.AddSpell(29) //greater heal
this.AddSpell(1) //clumsy
this.AddSpell(3) //feeblemind
this.AddSpell(5) //magic arrow
this.AddSpell(8) //weaken
this.AddSpell(38) //paralyze
this.AddSpell(51) //flamestrike
this.AddSpell(27) //curse
this.AddSpell(22) //teleport
this.AddSpell(7) //reactive armor
this.AddSpell(48) //reveal
this.AddSpell(10) //cunning
this.AddSpell(15) //protection
this.necroSpells = 0x3f

[SpellBookDef 0x2252]
name = "Book of Chivalry/Paladin"
defname = i_spellbook_paladin
layer = 1 //Set by Converter 
FirstSpellId = 201

on=@create
this.Contents = 0x3FF //10 spells

