//#1001 - the core spells Erebor kept out of reach: live skill 250.0 to 700.0 against a cap of 100.0, so never from a book,
//as nastaveni_SKILLREQ_ in systems/spellvalues.def. GMs skip that test, as in Sphere. A scroll skips it too but halves the
//same number for its roll, so it fizzles; Sphere's wands, difficulty 1, would work and aren't ported. Numbers not in the
//nastaveni_ table are spheretable_x.scp's.

[CreateFoodSpellDef 2]
DEFNAME=s_create_food
NAME=Create Food
SOUND=482
RUNES=IMY
CASTTIME=4
RUNEITEM=i_rune_CREATE_FOOD
SCROLLITEM=i_scroll_CREATE_FOOD
FLAGS=SpellFlag.CanTargetGround | SpellFlag.CanEffectGround | SpellFlag.EffectNeedsLOS
EFFECT=0
MANAUSE=5
Requirements=500.0 Magery

