//#1284 - the world events' people (WorldEvents.cs, OrcRaid.cs, Caravan.cs). Made by the events and gone with them; a
//restart clears any left (WorldEvents.ClearLeftovers). Not Erebor's: the archive's bandits (c_zm_bandita, 2000 hits) are a
//dungeon's, far too strong for a road.

[NPCDef c_event_raider]
TEVENTS = e_character
NAME = "Skreti najezdnik"
model = 0x11
AngerSound = snd_MONSTER_ORC1
IdleSound = snd_MONSTER_ORC1 + 1
AttackSound = snd_MONSTER_ORC1 + 2
HurtSound = snd_MONSTER_ORC1 + 3
DeathSound = snd_MONSTER_ORC1 + 4
CAN = MT_WALK|MT_RUN|MT_USEHANDS|MT_EQUIP
Str = 120
Dex = 90
Int = 30
MaxHits = 110 150
Wrestling = 550 700
Tactics = 550 700
NoAnimate = 1
AggroMode = Hostile

