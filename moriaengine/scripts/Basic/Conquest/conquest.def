//#1116 - Erebor's dobyvani-declarator.scp: the war declarator, one GM-placed in each realm (ConquestSetup). Its name gets
//the realm's adjective ("Gondorsky vyhlasovac valky") when its realm is set.
[WarDeclaratorDef i_war_declarator]
name = "vyhlasovac valky"
model = i_gravestone_5

//Erebor's dobyvani-palantir.scp: a keep's palantir, one GM-placed in each keep (ConquestSetup). Its name becomes
//"Palantir <keep>" when its keep is set.
[FortressPalantirDef i_fortress_palantir]
name = "Pevnostni palantir"
model = i_crystal_ball

//Erebor's cash box was a plain i_box_brass beside the palantir with the t_fort_cashbox event; here an item of its own.
[FortCashBoxDef i_fort_cashbox]
name = "Pokladna pevnosti"
model = 0x9ab

//Erebor's keep captain stones (systems/starostove-items.scp, nazguls_items.scp), one GM-placed in each keep
//(ConquestSetup): Gondor's keeps get i_captainstone, Mordor's i_mordorcaptainstone. Either serves whoever holds the keep.
[CaptainStoneDef i_captainstone]
name = "Captains stone"
model = i_grave_stone_5
Color = 099a

[CaptainStoneDef i_mordorcaptainstone]
name = "Mordor Captain's stone"
model = i_grave_stone_5
Color = 099a
