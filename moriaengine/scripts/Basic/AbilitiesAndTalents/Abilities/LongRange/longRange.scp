[ActivableAbilityDef a_longrange]
Name="Longrange"
Icon = 0x5209
EffectPower=3 //nastaveni_rangearrow_dstbonus, regardless of ability points - those are only relevant for success chance
EffectDuration=10
Cooldown = 20 //nastaveni_rangearrow_delay
Chance = 0.1 //nastaveni_rangearrow_chance: 100% at 10 points

PluginKey = @@longrange
PluginDef = p_longrange

on=@activate
	if (!a_longrange.CheckSuccess(this))
		this.Sysmessage(LocManager.GetEntry("loc_longrange", "LongrangeFailed", this.Language))
		return 1 //cancel
	endif


[LongRangePluginDef p_longrange]