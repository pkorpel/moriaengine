//#1401 - Erebor's energy shield (systems/specabilities.scp [function energyshield], i_energyshield, e_energy_shield,
//combat.scp f_dmgFinal_applyEnergyShield): EnergyShieldAbilityDef and EnergyShieldPlugin.
[EnergyShieldAbilityDef a_energy_shield]
Name="Energy Shield"
EffectPower=5 //tag.energyofshield: 5 a point
Resources = 1 i_gem_amethyst //was "i_amethyst" - no such item anywhere; i_gem_amethyst (resources.def) is the real one

PluginKey = @@energyShield
PluginDef = p_energyShield

[PassiveAbilityDef a_energy_shield_bonus]
Name="Energy Shield Bonus"

[EnergyShieldPluginDef p_energyShield]

[function energyshield]
a_energy_shield.Use(this)

[function cancelenergyshield]
a_energy_shield.Cancel(this)
