[function explevel]
InvalidateCombatWeaponValues()
InvalidateCombatArmorValues()
Dialog(d_explevel)

[Dialog d_explevel]
// Widened from 400 to 560, and the value column moved from x=250 to x=340 - at x=70,
// label text as long as "Weapon Attack/Piercing (P, M):" ran well past x=250, overlapping
// the value column that started there (#202).
// Extra 20px gap after the Name/Profession row (y=70 -> next row at 110, not 90) so it
// doesn't read as cramped against Level right below it (#204).
argo.resizepic 50 50 2620 560 340
argo.text 70 70 37 0
argo.text 70 110 3 1
argo.text 340 110 85 2
argo.text 70 130 3 3
argo.text 340 130 85 4
argo.text 70 150 3 5
argo.text 340 150 85 6
argo.text 70 170 3 7
argo.text 340 170 85 8
argo.text 70 190 3 9
argo.text 340 190 85 10
argo.text 70 210 3 11
argo.text 340 210 85 12
argo.text 70 230 3 13
argo.text 340 230 85 14

// Buttons to the point-spend dialogs (#156) - each opens with no args needed, they read self directly.
// Graphic 2445/2445 (flat "paper tab" look, same id for both up/down states) and offsets
// match Erebor's own d_explevel bottom row exactly (scripts/experiences.scp) - the previous
// 2151/2152 checkbox-style graphic looked like a toggle, not an action button.
argo.button 70 280 2445 2445 1 0 1
argo.text 75 282 3 15
argo.button 185 280 2445 2445 1 0 2
argo.text 190 282 3 16
argo.button 300 280 2445 2445 1 0 3
argo.text 305 282 3 17

[DIALOG d_explevel TEXT]
<Name>, <ProfessionName>
Level:
<Level>
Experience:
<Experience> / <NextLevelExperienceThreshold>
Armor Class (P, M):
<ArmorClassVsP>, <ArmorClassVsM>
Mind Defense (P, M):
<MindDefenseVsP>, <MindDefenseVsM>
Weapon Attack/Piercing (P, M):
<WeaponAttackVsP>/<WeaponPiercing>, <WeaponAttackVsM>/<WeaponPiercing>
Weapon Delay:
<WeaponDelay>
Mind Power (P, M):
<MindPowerVsP>, <MindPowerVsM>
Attributes
Skills
Abilities

[DIALOG d_explevel Button]
on=0

on=1
src.Dialog(d_levelspendattributes)

on=2
src.Dialog(d_levelspendskills)

on=3
src.Dialog(d_levelspendabilities)
