// Ranger (#136) - skill minimums/caps cross-verified against the original Sphere source
// (newbie_portals.scp's [profession 5]/zaklad_skilly blocks, re-fetched to scratchpad from
// gitlab.com/erebor/sphere-public-archive), weapons/armor/stats/spells from
// https://wiki.uoerebor.cz/docs/povolani/hranicar/. STR/DEX/INT/VIT stay native scale, not x10.
// No ttb1/ttb2/ttb3 talent-tree content - abilities are out of scope per #134.

[ProfessionDef profession_ranger]
Defname = class_ranger //class_ as alternate prefix
Name = "ranger"
professionPluginDef = p_profession_default

//SkillNameOrDefname = starting value, cap value
//not listed skills are considered 0, 0
Anatomy=300, 1000
AnimalLore=300, 1000
ArmsLore=0, 750
Archery=300, 1000
Begging=0, 500
Camping=0, 1000
Cartography=300, 1000
Cooking=300, 1000
DetectingHidden=0, 1000
EvaluatingIntel=0, 500
Fencing=0, 500
Fishing=300, 1000
Forensics=0, 750
Healing=300, 750
Herding=300, 1000
Hiding=0, 750
ItemID=0, 500
Lumberjacking=0, 1000
Magery=0, 750
Meditation=0, 500
Mining=0, 1000
Musicianship=0, 500
Parrying=0, 750
Peacemaking=0, 500
MagicResistance=0, 750
RemoveTrap=0, 500
SpiritSpeak=0, 750
Stealth=0, 750
Tactics=300, 1000
Taming=300, 1000
TasteID=0, 500
Tracking=0, 1000
Veterinary=300, 1000
Wrestling=0, 500

//weapon/armor restrictions (#135/#138) - bow and crossbow only, per the wiki's weapon list
//("luk"/"lehka kuse"/"tezka kuse"); falerovou/kruzkovou/kozenou armor (ringmail/chainmail/leather)
allowedWeaponTypes=Bow, XBow
allowedArmorMaterials=Ring, Chain, Leather

//STR/DEX/INT/VIT ranges {minimum, startingMax, hardCap} (#135/#134, native 0-100+ scale, NOT x10)
strRange=50, 80, 120
dexRange=80, 130, 200
intRange=60, 90, 90
vitRange=60, 90, 130

//title ladder by level, male/female (#165, ported from the original Sphere source's
//titul_ranger/titul_ranger_f)
titles="Wanderer", "Woodsman", "Tracker", "Tamer", "Archer", "Marksman", "Hunter", "Warden", "Strider", "Ranger"
titlesFemale="Wanderer", "Woodswoman", "Tracker", "Tamer", "Archer", "Markswoman", "Huntress", "Warden", "Strider", "Ranger"

//list allowed spells - Magic Arrow/Night Sight/Teleport/Recall/Dispel/Mark, per the wiki
allowedSpells=s_magic_arrow, s_nightsight, s_teleport, s_recall, s_dispel, s_mark
