[ProfessionDef profession_thief]
Defname = class_thief //class_ as alternate prefix
Name = "thief"
professionPluginDef = p_profession_default

//SkillNameOrDefname = starting value, cap value
//not listed skills are considered 0, 0
//
//Real finding while touching this file for #135/#138: Cooking/Fishing below were both missing
//their 300 starting value (same systematic conversion-tool bug found in mage.def, #137 -
//confirmed via the original Sphere source's zaklad_skilly block, base_thief_Cooking/Fishing=
//300). Also removed Stealing (previously 300,1000) entirely - the original source's own
//[profession 7] block caps Stealing at 0 (and even comments out its zaklad_skilly starting
//grant), consistent with stealing being disabled shard-wide on this engine (confirmed
//elsewhere this session) - granting it here was a bug, not a deliberate exception.

AnimalLore=0, 250
Alchemy=300, 1000
Anatomy=300, 1000
ArmsLore=0, 750
Parrying=0, 750
Begging=0, 1000
Camping=0, 750
Cooking=300, 1000
DetectingHidden=0, 1000
Discordance=0, 1000
EvaluatingIntel=0, 500
Healing=300, 750
Fishing=300, 1000
Forensics=0, 750
Hiding=300, 1000
Provocation=300, 1000
ItemID=0, 750
LockPicking=0, 1000
Magery=0, 500
MagicResistance=0, 500
Tactics=300, 1000
Snooping=0, 1000
Musicianship=0, 1000
Poisoning=0, 1000
Archery=300, 750
SpiritSpeak=0, 250
TasteID=0, 1000
Tracking=0, 500
Swordsmanship=0, 1000
Fencing=300, 1000
Wrestling=0, 750
Lumberjacking=0, 1000
Mining=0, 1000
Meditation=0, 500
Stealth=0, 1000
RemoveTrap=0, 1000

//AbilityNameOrDefname = display order, maximum points
a_regen_hits = 0, 20
a_regen_stam = 1, 20
a_regen_mana = 2, 20

a_weapon_dodge = 3, 40
a_spell_absorption = 4, 20

a_leech_hits = 5, 20
a_leech_stam = 6, 20
a_leech_mana = 7, 20

a_longrange = 8, 10
a_throwing = 9, 10
//blokace stitem
a_kick = 10, 10
//pretnuti slach
a_bleeding_strike = 11, 10
//Probodnuti
//Dmg za lvl

//list allowed spells
allowedSpells=s_magic_arrow, s_teleport, s_recall, s_mark

//weapon/armor restrictions (#135/#138) - kryss/war fork (Fencing-mapped spikes), cutlass/
//scimitar (Swords-mapped), and bows, per the wiki; chainmail and metal shields, per the wiki
//("Chainmail and metal shield types permitted")
allowedWeaponTypes=OneHandSpike, TwoHandSpike, OneHandSword, Bow
allowedArmorMaterials=Chain

//STR/DEX/INT/VIT ranges {minimum, startingMax, hardCap} (#135/#134, native 0-100+ scale, NOT x10)
strRange=60, 90, 120
dexRange=80, 120, 200
intRange=50, 80, 90
vitRange=70, 100, 140

//title ladder by level, male/female (#165, ported from the original Sphere source's
//titul_thief/titul_thief_f)
titles="Scoundrel", "Pilferer", "Sneak", "Pickpocket", "Footpad", "Robber", "Brigand", "Cutthroat", "Killer", "Assassin"
titlesFemale="Scoundrel", "Pilferer", "Sneak", "Pickpocket", "Footpad", "Robber", "Brigand", "Cutthroat", "Killer", "Assassin"

////3 talent tree branches
ttb1 = ttb_thief_assassin
ttb2 = ttb_thief_samurai
//ttb3 = ttb_mage_magician


