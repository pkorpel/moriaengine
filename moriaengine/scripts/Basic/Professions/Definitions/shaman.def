// Shaman (#136) - skill minimums/caps cross-verified against the original Sphere source
// (newbie_portals.scp's [profession 8]/zaklad_skilly blocks, re-fetched to scratchpad from
// gitlab.com/erebor/sphere-public-archive), weapons/armor/stats/spells from
// https://wiki.uoerebor.cz/docs/povolani/saman/. STR/DEX/INT/VIT stay native scale, not x10.
// No ttb1/ttb2/ttb3 talent-tree content - abilities are out of scope per #134.

[ProfessionDef profession_shaman]
Defname = class_shaman //class_ as alternate prefix
PvPArmorChange = -12 //nastaveni_global_armorchange_vP
Name = "shaman"
professionPluginDef = p_profession_default

//SkillNameOrDefname = starting value, cap value
//not listed skills are considered 0, 0
AnimalLore=0, 750
Anatomy=300, 1000
ArmsLore=0, 500
Begging=0, 500
Camping=0, 750
Cartography=300, 1000
Cooking=300, 1000
DetectingHidden=0, 1000
EvaluatingIntel=300, 750
Fencing=0, 500
Fishing=300, 1000
Forensics=0, 1000
Healing=300, 1000
Herding=0, 500
Hiding=0, 750
ItemID=0, 500
Lumberjacking=0, 1000
Macefighting=0, 750
Magery=300, 1000
MagicResistance=0, 1000
Meditation=300, 1000
Mining=0, 1000
Musicianship=0, 750
Parrying=0, 750
Poisoning=0, 500
Provocation=0, 750
RemoveTrap=0, 500
SpiritSpeak=300, 1000
Stealth=0, 500
Tactics=0, 250
TasteID=0, 1000
Tracking=0, 750
Veterinary=0, 750
Wrestling=0, 500

//weapon/armor restrictions (#135/#138) - maces and magical staves only, per the wiki ("muze
//pouzivat palcaty a magicke hole"); chainmail and ringmail only, per the wiki
allowedWeaponTypes=OneHandBlunt, TwoHandBlunt
allowedArmorMaterials=Chain, Ring

//STR/DEX/INT/VIT ranges {minimum, startingMax, hardCap} (#135/#134, native 0-100+ scale, NOT x10)
strRange=60, 80, 120
dexRange=60, 80, 110
intRange=90, 110, 200
vitRange=70, 90, 120

//title ladder by level, male/female (#165, ported from the original Sphere source's
//titul_shaman/titul_shaman_f)
titles="Pagan", "Infidel", "Thinker", "Dissenter", "Heretic", "Herbalist", "Occultist", "Charmer", "Conjurer", "Exorcist"
titlesFemale="Pagan", "Infidel", "Thinker", "Dissenter", "Heretic", "Herbalist", "Occultist", "Charmer", "Conjurer", "Exorcist"

//list allowed spells, per the wiki - Reactive Armor and Mana Drain are omitted, not
//implemented in this engine (unimplementedSpells.def); Frost Bolt isn't implemented at all
//(no SpellDef exists for it anywhere in this engine, not even as a commented-out stub).
allowedSpells=s_clumsy, s_feeblemind, s_magic_arrow, s_nightsight, s_weaken, s_cunning, s_cure, s_harm, s_protection, s_poison, s_teleport, s_curse, s_recall, s_dispel_field, s_mind_blast, s_paralyze, s_dispel, s_energy_bolt, s_mark, s_energy_field, s_mass_dispel, s_gate_travel, s_resurrection
//s_reactive_armor, s_mana_drain - not implemented in this engine; Frost Bolt doesn't exist at all
