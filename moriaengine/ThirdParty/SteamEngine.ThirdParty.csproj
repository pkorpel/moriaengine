<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SteamEngine.ThirdParty</RootNamespace>
    <AssemblyName>SteamEngine.ThirdParty</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Encryption\COPYING" />
    <None Remove="Encryption\README" />
    <None Remove="Grammatica\LICENSE-GPL.txt" />
    <None Remove="Grammatica\LICENSE.txt" />
    <None Remove="Grammatica\notice.txt" />
    <None Remove="Grammatica\README.txt" />
  </ItemGroup>

</Project>
