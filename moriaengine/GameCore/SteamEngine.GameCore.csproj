<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SteamEngineTargetFramework)</TargetFramework>
    <RootNamespace>SteamEngine</RootNamespace>
    <AssemblyName>SteamEngine.GameCore</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpConfig" Version="4.1.0" />
    <None Remove="LScript\generate.bat" />
    <None Remove="LScript\LScript_strict.grammar" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\SteamEngine.Common.csproj" />
    <ProjectReference Include="..\Communication\SteamEngine.Communication.csproj" />
    <ProjectReference Include="..\ThirdParty\SteamEngine.ThirdParty.csproj" />
    <ProjectReference Include="..\Tools\SteamEngine.Generators.Abstractions\SteamEngine.Generators.Abstractions.csproj" />

    <ProjectReference Include="..\Tools\SteamEngine.Generators\SteamEngine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
