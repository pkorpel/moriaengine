{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledMcpjsonServers": ["github"],
  "permissions": {
    "allow": [
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__list_label",
      "mcp__github__get_label",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "Bash(scripts/test-fast.sh*)",
      "Bash(scripts/test-full.sh*)",
      "Bash(scripts/run-local.sh*)",
      "Bash(scripts/motd.sh*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git commit * --no-verify *)",
      "Bash(git push * --no-verify *)",
      "Bash(git push * HEAD:refs/heads/main)",
      "Bash(git push * agent-kit-trial)",
      "Bash(git push * HEAD:agent-kit-trial)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/protect_tests.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/motd.sh\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/motd.sh\" --line",
    "refreshInterval": 30
  }
}
